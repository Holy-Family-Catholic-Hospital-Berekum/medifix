rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserID() {
      return getUserData().ID;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isEstateManager() {
      return isAuthenticated() && getUserRole() == 'estate';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() == 'staff';
    }

    function isWorker() {
      return isAuthenticated() && getUserRole() == 'worker';
    }

    function isProcurement() {
      return isAuthenticated() && getUserRole() == 'procurement';
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isManager() ||
        isEstateManager() ||
        isProcurement()
      );

      allow list: if isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        isEstateManager() ||
        isProcurement() ||
        request.query.limit <= 1 ||
        (isStaff() && request.query.limit <= 10)
      );

      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role in ['staff', 'worker', 'estate', 'admin', 'manager', 'procurement'] &&
        request.resource.data.keys().hasAll([
          'name', 'email', 'role', 'ID',
          'phoneNumber', 'location', 'profession', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.role is string &&
        request.resource.data.ID is string &&
        request.resource.data.phoneNumber is string &&
        request.resource.data.location is string &&
        request.resource.data.profession is string;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isManager() &&
          resource.data.role != 'admin' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deactivated'])) ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'deactivated']))
      );

      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isAuthenticated() && (
        isAdmin() ||
        isEstateManager() ||
        isProcurement() ||
        (isStaff() && resource.data.reporterId == getUserID()) ||
        (isWorker() && resource.data.assignedTo == getUserID())
      );

      allow list: if isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        isEstateManager() ||
        isProcurement() ||
        isStaff() ||
        isWorker()
      );

      allow create: if isAuthenticated() &&
        isStaff() &&
        request.resource.data.status == 'incoming' &&
        request.resource.data.reporterId == getUserID() &&
        request.resource.data.keys().hasAll([
          'status', 'reporterId', 'reporter', 'category',
          'priorityLevel', 'location', 'reportDescription'
        ]) &&
        request.resource.data.reporterId is string &&
        request.resource.data.reporter is string &&
        request.resource.data.category is string &&
        request.resource.data.priorityLevel in ['urgent', 'routine', 'emergency'] &&
        request.resource.data.location is string &&
        request.resource.data.reportDescription is string;

      allow update: if isAuthenticated() && (
        ((isAdmin() || isEstateManager()) &&
          request.resource.data.overdue == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['overdue'])) ||

        (isAdmin() &&
          resource.data.status == 'incoming' &&
          request.resource.data.status in ['approved', 'denied'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateApproved', 'alerts', 'dateDue'])) ||

        (isAdmin() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'confirmed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateConfirmed', 'alerts'])) ||

        (isAdmin() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'costDenied' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateCostDenied', 'alerts'])) ||

        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])) ||

        (isEstateManager() &&
          (resource.data.status == 'approved' || resource.data.status == 'costDenied') &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materials', 'status', 'dateCostAdded'])) ||

        (isEstateManager() &&
          (resource.data.status == 'confirmed' || resource.data.status == 'assigned' || resource.data.status == 'approved') &&
          request.resource.data.status == 'assigned' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTo', 'status', 'dateAssigned', 'alerts', 'instructions'])) ||

        (isEstateManager() &&
          (resource.data.status == 'assigned' || resource.data.status == 'confirmed') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['instructions', 'alerts'])) ||

        (isEstateManager() &&
          (resource.data.status == 'assigned' || resource.data.status == 'completed') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cost'])) ||

        (isWorker() &&
          resource.data.assignedTo == getUserID() &&
          resource.data.status == 'assigned' &&
          request.resource.data.status == 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dateCompleted'])) ||

        (isStaff() &&
          resource.data.reporterId == getUserID() &&
          resource.data.status == 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'feedbackDate', 'alerts'])) ||

        (isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackViewedBy']))
      );

      allow delete: if isAdmin() ||
        (isStaff() && resource.data.reporterId == getUserID() && resource.data.status == 'incoming');
    }

    match /registrationIDs/{registrationId} {
      allow get: if true;

      allow list: if isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        isEstateManager()
      );

      allow create: if isAuthenticated() && (
        (isAdmin() &&
          request.resource.data.type in ['estate', 'staff', 'worker', 'manager', 'procurement'] &&
          request.resource.data.used == false &&
          request.resource.data.keys().hasAll(['type', 'used'])) ||

        (isManager() &&
          request.resource.data.type in ['estate', 'staff', 'worker', 'procurement'] &&
          request.resource.data.used == false &&
          request.resource.data.keys().hasAll(['type', 'used'])) ||

        (isEstateManager() &&
          request.resource.data.type in ['staff', 'worker'] &&
          request.resource.data.used == false &&
          request.resource.data.keys().hasAll(['type', 'used']))
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        isManager() ||
        isEstateManager() ||
        (resource.data.used == false &&
          request.resource.data.used == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']))
      );

      allow delete: if isAuthenticated() && (isAdmin() || isManager() || isEstateManager());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}